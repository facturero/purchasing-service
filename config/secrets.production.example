# Plantilla de los secretos de producción de purchasing-service. NO se sube tal cual: se copia a secrets.production.dec, se rellena
# y se cifra con SOPS (clave age de .sops.yaml) a config/secrets.production.enc, que es lo único que va al repo:
#
#   cp config/secrets.production.example /tmp/purchasing.env   # rellenar
#   SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt sops -e --input-type dotenv --output-type dotenv /tmp/purchasing.env > config/secrets.production.enc
#   rm /tmp/purchasing.env
#
# Cuidado: el archivo con LF, sin retorno de carro (CRLF). Un \r al final de DB_HOST o DB_USER rompe la conexión (nos pasó con accounting).
# La base y el usuario se crean una vez en el MySQL del clúster:
#   CREATE DATABASE IF NOT EXISTS purchasing_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER IF NOT EXISTS 'purchasing_user'@'%' IDENTIFIED BY '<contraseña fuerte nueva>';
#   GRANT ALL PRIVILEGES ON purchasing_db.* TO 'purchasing_user'@'%';
DB_HOST=mysql-basic
DB_PORT=3306
DB_USER=purchasing_user
DB_PASSWORD=<la contraseña de purchasing_user>
DB_NAME=purchasing_db
RABBITMQ_URL=amqp://rabbitmq:5672
# Clave AES-256-GCM (32 bytes en hex = 64 caracteres) con la que purchasing cifra las
# credenciales del portal del SRI. Si se pierde, las credenciales guardadas dejan de poder
# descifrarse y hay que volver a guardarlas desde /purchasing. Se guarda fuera del repo.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SRI_PORTAL_ENCRYPTION_KEY=<64 caracteres hex>
